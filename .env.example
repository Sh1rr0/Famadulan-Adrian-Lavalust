# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# API Configuration (generate separate random values of at least 32 characters)
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Set this to the exact origin of the frontend deployed in production.
# Use * only when the API is intentionally public to browser origins.
CORS_ALLOW_ORIGIN=https://my-react-app-aj-b506.vercel.app
